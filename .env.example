# Backend API URL
VITE_API_URL=http://localhost:3000/api

# Stellar Network Configuration
VITE_STELLAR_NETWORK=TESTNET
VITE_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
VITE_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Smart Contract Deployment ID (Soroban Testnet)
VITE_STORMSALE_CONTRACT_ID=

# Platform Auditor Key for Automated SOC 2 Type II Evidence Packaging
# Ed25519 Secret Key (Stellar format S... or 64-char hex string)
# Used to sign evidence manifests, root digests, and verification receipts.
# Generate a new keypair using: node scripts/generate-auditor-key.mjs
VITE_AUDITOR_PRIVATE_KEY=

