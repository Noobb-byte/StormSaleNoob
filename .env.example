# Backend API URL (If deploying to a custom origin outside localhost:3000/3001, add the origin to index.html CSP connect-src)
VITE_API_URL=http://localhost:3000/api

# Stellar Network Configuration
VITE_STELLAR_NETWORK=TESTNET
# If using a custom RPC or Horizon provider outside *.stellar.org, add the origin to index.html CSP connect-src
VITE_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
VITE_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
VITE_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Smart Contract Deployment ID (Soroban Testnet)
VITE_STORMSALE_CONTRACT_ID=
